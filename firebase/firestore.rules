rules_version = '2';

// Paste this into: Firebase Console > Firestore Database > Rules > Publish.
//
// SECURITY MODEL
// Firebase's Email/Password sign-in lets ANYONE create an account against
// this project from a browser — the API key in firebase-config.js is public
// by design. So "is this person logged in?" is NOT a safe permission check
// on its own.
//
// Instead, write access requires the account to be on an allowlist: either
// its email address is named in these rules, or its UID has a document in
// the `admins` collection. Neither can be granted from the website — the
// email list lives here and these rules are only editable in the Console,
// and the rules below forbid writing `admins` documents entirely. So a
// stranger who signs themselves up gets an account that can do nothing.

service cloud.firestore {
  match /databases/{database}/documents {

    // Who counts as an admin. Two ways to qualify, and either is enough.
    //
    // 1. The owner address named below. This is the bootstrap — it works even
    //    with an empty database, so there is no way to lock everyone out.
    // 2. A document in `adminEmails` whose **ID is the person's email
    //    address**. This is how people get added and removed day to day: no
    //    rules edit, no republish, and it takes effect immediately.
    //
    // Both are keyed on the email address rather than the account's UID, and
    // that is the whole point. A UID is 28 random characters, it is
    // regenerated whenever an account is deleted and recreated, and the
    // Console truncates it in the user list. Worse, when a UID-keyed document
    // is wrong — a mis-copied character, an invisible character riding along
    // with the paste — the result is a document that looks completely correct
    // and grants nothing, with no error anywhere to say so. An email address
    // is readable, so a wrong one is visible.
    //
    // Emails are compared lowercased, so create the documents with lowercase
    // IDs and a capitalised sign-in still matches.
    //
    // IMPORTANT: replace the placeholder below with the real owner address
    // BEFORE publishing, and leave the real address out of this file when
    // committing it. This repository is public, and a live admin address
    // published here tells an attacker exactly which account to go after
    // while protecting nothing — the rules stored in Firebase are what
    // enforce access, and those are only editable from the Console.
    function isAdmin() {
      return request.auth != null
        && (
          // 1. The bootstrap owner address.
          (request.auth.token.email != null
            && request.auth.token.email.lower() in [
                 'owner@example.com'
               ])
          // 2. A document whose ID is their email address.
          || (request.auth.token.email != null
            && exists(/databases/$(database)/documents/adminEmails/$(request.auth.token.email.lower())))
          // 3. A document whose ID is their Auth UID. Kept so an existing
          //    setup keeps working, but prefer route 2 — see the note above
          //    about why a UID-keyed document fails invisibly.
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    // Basic shape/size checks so the public contact form can't be used to
    // dump arbitrary data or huge payloads into the database.
    // The contact form is open to the world — that is the point of a contact
    // form — so this is the only thing standing between it and being used as
    // free storage. Size limits on the known fields are not enough on their
    // own: without hasOnly, anything at all could be attached alongside them
    // and written up to Firestore's 1 MB per-document limit.
    function validInquiry() {
      let d = request.resource.data;
      return d.keys().hasOnly(
             ['name', 'email', 'phone', 'inquiryType', 'item', 'message',
              'status', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.email is string && d.email.size() > 0 && d.email.size() <= 200
        && d.message is string && d.message.size() > 0 && d.message.size() <= 2000
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 40))
        && (!('item' in d) || (d.item is string && d.item.size() <= 200))
        && (!('inquiryType' in d) || (d.inquiryType is string && d.inquiryType.size() <= 60))
        && d.status == 'new';
    }

    // The admin allowlist. Add a document here (ID = the user's Firebase
    // Auth UID) to grant someone admin access. Never writable from the site.
    // The admin allowlist. Document ID = the person's email address,
    // lowercase. Add one from the Console to grant access; delete it to
    // revoke. Never writable from the website, so nobody can promote
    // themselves — including someone who signs up an account of their own.
    match /adminEmails/{email} {
      allow read, write: if false;
    }

    // The older UID-keyed allowlist, still honoured. Same rules: Console only,
    // never writable from the site.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Each admin's own settings (e.g. whether they've changed their
    // starting password). Readable/writable only by that admin, and only
    // for their own document.
    match /adminProfile/{uid} {
      allow read, write: if isAdmin() && request.auth.uid == uid;
    }

    // Products: public site reads them; only an allowlisted admin writes.
    // Photos live in the `photoUrl` field as a compressed data URL (see
    // js/image-utils.js) rather than in Firebase Storage, which keeps the
    // project on the free Spark plan. The browser compresses to roughly
    // 100-250 KB; this guard is a backstop below Firestore's 1 MB doc cap.
    match /products/{productId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && (!('photoUrl' in request.resource.data)
            || request.resource.data.photoUrl == null
            || request.resource.data.photoUrl.size() < 900000);
    }

    // Inquiries: anyone can submit one (that's the point of a contact
    // form), but only an admin can read or manage them.
    match /inquiries/{inquiryId} {
      allow create: if validInquiry();
      allow read, update, delete: if isAdmin();
    }

    // The page photos that aren't product items (hero, storefront). Public
    // site reads them; only an allowlisted admin can change them. Same size
    // guard as products, since these are stored as compressed data URLs
    // rather than in Firebase Storage.
    match /site/images {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['hero', 'storefront', 'updatedAt'])
        && (!('hero' in request.resource.data)
            || request.resource.data.hero == null
            || request.resource.data.hero.size() < 900000)
        && (!('storefront' in request.resource.data)
            || request.resource.data.storefront == null
            || request.resource.data.storefront.size() < 900000);
    }

    // Dashboard bookkeeping — currently just a flag recording that the
    // starter items were seeded once, so deleting them all doesn't cause
    // them to reappear on the next login.
    match /site/config {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['seeded']);
    }
  }
}
