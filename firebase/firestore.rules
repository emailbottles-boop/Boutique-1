rules_version = '2';

// Paste this into: Firebase Console > Firestore Database > Rules > Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Products: anyone can read (public site), only the logged-in admin
    // can add, edit, or delete.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Inquiries: anyone can submit (the contact form), but only the
    // logged-in admin can read, update (e.g. mark handled), or delete them.
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
