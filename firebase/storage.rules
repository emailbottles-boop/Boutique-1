rules_version = '2';

// ============================================================
// OPTIONAL — you do NOT need this file for the site to work.
// ============================================================
//
// This project does not use Firebase Storage. Product photos are
// compressed in the browser and stored directly in Firestore (see
// js/image-utils.js), because enabling Storage on newer Firebase
// projects requires upgrading to the Blaze plan and attaching a credit
// card. Avoiding it keeps everything on the free Spark plan.
//
// You only need to publish these rules IF you later enable Storage —
// for example if the shop grows enough that photos should be served
// from a CDN instead of the database. Until then, skip this file
// entirely; there is no Storage bucket for it to apply to.
//
// If you do enable Storage later, paste this into:
//   Firebase Console > Storage > Rules > Publish

service firebase.storage {
  match /b/{bucket}/o {

    match /product-photos/{allPaths=**} {
      // Public site needs to display the photos.
      allow read: if true;

      // Same security model as firestore.rules: being signed in is not
      // enough, because anyone can create an account. Uploading requires
      // the user's UID to be in the `admins` Firestore collection, which
      // is only editable from the Firebase Console.
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Nothing else in the bucket is reachable from the website.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
