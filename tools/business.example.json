// business.example.json — worked example for the generator.
//
// This file is JSON with comments allowed (stripped by generate_site.py
// before parsing) — both full-line "//" comments and trailing "// ..."
// comments after a value are fine, as are /* ... */ blocks. URLs like
// "https://example.com" inside string values are never touched. See
// tools/README.md for the full field reference.
//
// This particular example recreates the original Bridget's Boutique site.
// Copy this file, rename it (e.g. petes-auto-shop.json), and edit every
// field for the new business. Fields not marked "required" below are
// optional — the generator fills in sensible generic defaults if omitted.
{
  // ---- Required basics ----
  "business_name": "Bridget's Boutique",
  "tagline": "Women's fashion, hand-picked weekly.",
  "description": "Bridget's Boutique is a women's clothing boutique in downtown Enumclaw, WA. New arrivals weekly — shop in store or inquire online.",
  "phone": "(360) 625-8032",
  "email": "hello@bridgetsboutiqueenumclaw.com",
  "domain": "https://www.bridgetsboutiqueenumclaw.com",

  // schema.org business type — used for the JSON-LD structured data that
  // powers Google's local-business rich results. Pick the closest match:
  // ClothingStore, AutoRepair, Florist, Restaurant, HairSalon, BeautySalon,
  // Bakery, BookStore, JewelryStore, ShoeStore, HomeGoodsStore, Store, etc.
  // Full list: https://schema.org/docs/full.html (search "LocalBusiness").
  "schema_type": "ClothingStore",

  // Required: street/city/state/zip. "country" and "state_full" are optional
  // (state_full is used in the footer, e.g. "Washington" instead of "WA").
  "address": {
    "street": "1617 Cole St",
    "city": "Enumclaw",
    "state": "WA",
    "state_full": "Washington",
    "zip": "98022",
    "country": "US"
  },

  // ---- Optional basics ----
  "price_range": "$$",              // shown in JSON-LD; roughly $, $$, $$$, $$$$
  "country_code": "1",              // used to build the tel: link from "phone"
  "footer_tagline": "Women's clothing boutique in downtown Enumclaw, WA. New arrivals every week.",
  "deploy_branch": "main",          // branch the GitHub Actions workflow deploys from
  "firebase_project_id": "YOUR_FIREBASE_PROJECT_ID",  // fill in after creating the Firebase project

  // ---- Hours ----
  // Keys are lowercase day names. Omit a day (or set it to null) to show
  // "Closed". Times are 24-hour "HH:MM".
  "hours": {
    "monday":    { "open": "10:00", "close": "17:00" },
    "tuesday":   { "open": "10:00", "close": "17:00" },
    "wednesday": { "open": "10:00", "close": "17:00" },
    "thursday":  { "open": "10:00", "close": "17:00" },
    "friday":    { "open": "10:00", "close": "19:00" },
    "saturday":  { "open": "10:00", "close": "19:00" },
    "sunday":    { "open": "11:00", "close": "17:00" }
  },

  // ---- Social links (all optional — omit any platform the business doesn't use) ----
  "socials": {
    "instagram": "https://www.instagram.com/bridgetsboutiqueenumclaw/",
    "facebook": "https://www.facebook.com/BridgetsBoutiqueEnumclaw/",
    // Optional: a specific Instagram post URL to embed on the home page.
    // Leave this out entirely to skip the embed (the "Follow Along" section
    // still shows, just without the embedded post).
    "instagram_post_url": "https://www.instagram.com/p/DVhpxokkSsK/",
    // Any other platforms (Yelp, TikTok, Google Business Profile, etc.) —
    // shown as extra buttons wherever social links appear.
    "others": []
  },

  // ---- Brand colors (all optional — omit "colors" entirely for the default palette) ----
  // Any hex color. "accent"/"accent_dark" is the warm highlight color used
  // on hover states and badges; "gold" is the fine-line accent (underlines,
  // focus rings).
  "colors": {
    "cream": "#faf6f1",
    "cream_dark": "#f1e9df",
    "accent": "#d9a9a0",
    "accent_dark": "#c48b81",
    "charcoal": "#2b2523",
    "charcoal_soft": "#4a423e",
    "gold": "#b08d57"
  },

  // ---- Fonts (optional — must be real Google Fonts family names) ----
  "fonts": {
    "heading": "Playfair Display",
    "body": "Jost",
    "heading_weights": "500;600;700",
    "body_weights": "400;500;600"
  },

  // ---- Labels / vocabulary ----
  // What to call the "contact" call-to-action button across the site.
  "labels": {
    "contact_cta": "Inquire to Order"
  },

  // ---- Catalog ----
  // Omit "catalog" entirely (or set catalog.enabled = false) for a business
  // with no product/service listing — shop.html won't be generated and every
  // nav/footer link to it is removed automatically.
  "catalog": {
    "enabled": true,
    "nav_label": "New Arrivals",     // what the nav link / page title says
    "item_singular": "item",         // e.g. "vehicle", "bouquet", "treatment"
    "item_plural": "arrivals",       // e.g. "vehicles", "bouquets", "treatments"

    // Category filter pills on the catalog page + the admin category dropdown.
    // "key" must be lowercase, no spaces (use hyphens). If omitted entirely,
    // categories are auto-derived from whatever categories the items below use.
    "categories": [
      { "key": "dresses",     "label": "Dresses & Bottoms" },
      { "key": "tops",        "label": "Tops" },
      { "key": "outerwear",   "label": "Outerwear" },
      { "key": "accessories", "label": "Accessories" }
    ],

    // Seed/demo items shown until the owner adds real ones from admin.html
    // (or forever, if Firebase is never connected). "tag" is optional
    // ("New", "Sale", etc). "category" must match one of the keys above.
    "items": [
      { "name": "Floral Wrap Dress",    "category": "dresses",     "price": "$68", "tag": "Example" },
      { "name": "Cropped Denim Jacket", "category": "outerwear",   "price": "$74", "tag": "New" },
      { "name": "Ribbed Knit Top",      "category": "tops",        "price": "$38", "tag": "New" },
      { "name": "Gold Layered Necklace","category": "accessories", "price": "$26", "tag": "New" },
      { "name": "Red Skinny Jeans",     "category": "dresses",     "price": "$54", "tag": "Example" },
      { "name": "Suede Crossbody Bag",  "category": "accessories", "price": "$58" },
      { "name": "Off-Shoulder Blouse",  "category": "tops",        "price": "$42" },
      { "name": "Sherpa-Lined Vest",    "category": "outerwear",   "price": "$66" }
    ]
  },

  // ---- Home page copy (all optional — generic defaults are generated from
  // business_name/city/catalog if omitted) ----
  "home": {
    "eyebrow": "Downtown Enumclaw, WA",
    "headline": "Women's fashion, hand-picked weekly.",
    "subcopy": "Bridget's Boutique has been dressing Enumclaw for years — new arrivals land every week, and our community follows along on Instagram and Facebook to see them first.",
    // Optional stat callouts under the hero copy. Omit "stats" entirely to
    // hide this row (most new businesses won't have numbers like this yet).
    "stats": [
      { "value": "8,463+", "label": "Facebook Likes" },
      { "value": "4,694+", "label": "Instagram Followers" },
      { "value": "Weekly", "label": "New Arrivals" }
    ],
    "impact_eyebrow": "Downtown Enumclaw",
    "impact_heading": "Thousands of followers. One storefront finally catching up.",
    "impact_body": "Bridget's Boutique built a loyal community on Instagram and Facebook long before it had a website — now that same weekly-new-arrivals energy lives here too.",
    "local_heading": "A downtown Enumclaw favorite.",
    "local_body": "For years, Bridget's Boutique has brought carefully curated women's fashion to Enumclaw — the kind of place where the racks change every week and there's always something new to find."
  },

  // ---- About page copy (all optional) ----
  "about": {
    "eyebrow": "Enumclaw, Washington",
    "heading": "Small-town roots, big style.",
    "subhead": "A locally owned boutique in the heart of downtown Enumclaw.",
    "paragraphs": [
      "Bridget's Boutique sits right on Cole Street in downtown Enumclaw, where we've built a loyal following of shoppers who love finding something new every time they stop in. Our racks turn over constantly — new clothing, jewelry, and accessories arrive weekly.",
      "We believe in personal service, an eye for what actually looks great, and making sure everyone who walks in (or shops with us online) leaves with something they love."
    ],
    "meta_description": "Bridget's Boutique is a locally owned women's clothing boutique in downtown Enumclaw, WA."
  },

  // Three feature cards on the About page ("Why customers keep coming back").
  // Optional — generic defaults are used if omitted.
  "why_cards": [
    { "title": "New Arrivals Weekly", "body": "Our inventory changes constantly — there's always something new to discover, in store and online." },
    { "title": "Personal Styling", "body": "Not sure what you're looking for? Our team is happy to help you put a look together, in store or by message." },
    { "title": "A Real Community", "body": "Followers on Instagram and Facebook trust us for what's trending — join in and shop the looks you see." }
  ],

  // Optional overrides for the auto-generated meta descriptions of the
  // catalog/contact pages (home/about have their own fields above).
  "catalog_description": "Browse the latest new arrivals at Bridget's Boutique in Enumclaw, WA. Inquire to order online, or shop in store.",
  "catalog_intro": "Fresh finds land in store every week. Don't see your size or want to reserve a piece? Inquire and we'll get back to you.",
  "contact_description": "Get in touch with Bridget's Boutique in Enumclaw, WA — inquire about an item, ask a question, or plan your visit."
}
