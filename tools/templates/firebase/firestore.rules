rules_version = '2';

// Paste this into: Firebase Console > Firestore Database > Rules > Publish.
//
// SECURITY MODEL
// Firebase's Email/Password sign-in lets ANYONE create an account against
// this project from a browser — the API key in firebase-config.js is public
// by design. So "is this person logged in?" is NOT a safe permission check
// on its own.
//
// Instead, write access requires the user's UID to be listed in the
// `admins` collection. Those documents can only be created from the
// Firebase Console (rules below forbid writing them from the website), so
// a stranger who signs themselves up gets an account that can do nothing.

service cloud.firestore {
  match /databases/{database}/documents {

    // Who counts as an admin. Two ways to qualify, and either is enough.
    //
    // 1. Your email is named below. Preferred for the site owner: an email is
    //    readable, it survives deleting and recreating the account, and a typo
    //    in one is visible. A UID is 28 random characters, is regenerated
    //    whenever an account is recreated, and is truncated in the Console —
    //    keeping a document ID matched to one by hand locks owners out.
    // 2. Your UID has a document in the `admins` collection. Kept because it
    //    grants access without republishing these rules.
    //
    // IMPORTANT: replace the placeholder with the owner's real address BEFORE
    // publishing, and leave the real address out of any public repository.
    // The rules stored in Firebase are what enforce access, and those are
    // only editable from the Console.
    function isAdminEmail() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
             'owner@example.com'
           ];
    }

    function isAdmin() {
      return request.auth != null
        && (isAdminEmail()
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // The contact form is open to the world — that is the point of a contact
    // form — so this is the only thing standing between it and being used as
    // free storage. Size limits on the known fields are not enough on their
    // own: without hasOnly, anything at all could be attached alongside them
    // and written up to Firestore's 1 MB per-document limit.
    function validInquiry() {
      let d = request.resource.data;
      return d.keys().hasOnly(
             ['name', 'email', 'phone', 'inquiryType', 'item', 'message',
              'status', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.email is string && d.email.size() > 0 && d.email.size() <= 200
        && d.message is string && d.message.size() > 0 && d.message.size() <= 2000
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 40))
        && (!('item' in d) || (d.item is string && d.item.size() <= 200))
        && (!('inquiryType' in d) || (d.inquiryType is string && d.inquiryType.size() <= 60))
        && d.status == 'new';
    }

    // The admin allowlist. Add a document here (ID = the user's Firebase
    // Auth UID) to grant someone admin access. Never writable from the site.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Each admin's own settings (e.g. whether they've changed their
    // starting password). Readable/writable only by that admin.
    match /adminProfile/{uid} {
      allow read, write: if isAdmin() && request.auth.uid == uid;
    }

    // Products: public site reads them; only an allowlisted admin writes.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Inquiries: anyone can submit one (that's the point of a contact
    // form), but only an admin can read or manage them.
    match /inquiries/{inquiryId} {
      allow create: if validInquiry();
      allow read, update, delete: if isAdmin();
    }
  }
}
